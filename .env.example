# Copy to .env.local and fill in. .env.local is gitignored and never reaches the client.
# Every one of these is server-side only — do NOT prefix any with NEXT_PUBLIC_.

# Google AI Studio (Gemini). Free tier is Flash-only as of 2026.
GEMINI_API_KEY=

# Optional. Flash-Lite has more headroom on the free tier's 10 req/min.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. The compose stage is the hardest — a large structured document under
# many constraints. If itineraries keep failing validation, point this at a
# stronger model; it costs one call per trip.
# GEMINI_MODEL_COMPOSE=gemini-3.5-flash

# Single Google Maps Platform key with these APIs enabled in the Cloud project:
#   Geocoding API, Places API (New), Routes API, Weather API
GOOGLE_MAPS_API_KEY=

# Supabase — added in Phase 5 (itinerary persistence + share links).
# Leave blank until then; the pipeline runs fine without them.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Abuse + cost protection (strongly recommended before sharing the URL)
#
# Serverless functions share no memory, so rate limits need external state.
# Upstash Redis free tier (500K commands/month) is enough for this.
# Without these, limits fall back to per-instance memory and will NOT hold.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Plans one IP may start per 10 minutes.
RATE_LIMIT_PER_IP=3

# Autocomplete searches one IP may make per minute. This endpoint fires on
# every keystroke and has no per-plan cost ceiling behind it, so it needs its
# own cap.
RATE_LIMIT_AUTOCOMPLETE_PER_IP=20

# Total plans served per day across ALL visitors. This is the real cost
# ceiling: ~$1.80 per plan, so 60/day is roughly $110/day worst case.
# Set it to what you are genuinely willing to spend.
DAILY_PLAN_CAP=60
