# Copy to .env.local and fill in. .env.local is gitignored and never reaches the client.
# Every one of these is server-side only — do NOT prefix any with NEXT_PUBLIC_.

# Google AI Studio (Gemini). Free tier is Flash-only as of 2026.
GEMINI_API_KEY=

# Optional. Flash-Lite has more headroom on the free tier's 10 req/min.
GEMINI_MODEL=gemini-3.5-flash-lite

# Single Google Maps Platform key with these APIs enabled in the Cloud project:
#   Geocoding API, Places API (New), Routes API, Weather API
GOOGLE_MAPS_API_KEY=

# Supabase — added in Phase 5 (itinerary persistence + share links).
# Leave blank until then; the pipeline runs fine without them.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
